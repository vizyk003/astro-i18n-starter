---
// Footer UI displayed on each page.
import { useTranslations, type Lang } from "@/i18n";
const t = useTranslations(Astro.currentLocale as Lang);
---

<footer class="l-footer l-content">
  <div class="footer-content">
    <div class="footer-brand">
      <h3>Mosaik Digital</h3>
      <p>
        {
          t({
            ja: "デジタルの未来を創造する",
            en: "Crafting Digital Futures",
            "zh-cn": "打造数字未来",
            ar: "صياغة المستقبل الرقمي",
          })
        }
      </p>
    </div>
  </div>

  <p class="copy" dir="ltr">
    © Mosaik Digital {new Date().getFullYear()}. All rights reserved.
  </p>
</footer>

<style>
  footer {
    padding-block: var(--sp-m) var(--sp-l);
    text-align: center;
    background-color: var(--color-theme);
    color: var(--color-base);
    border-radius: 16px;
    margin-block-end: -16px;
  }

  .footer-content {
    margin-block-end: var(--sp-m);
  }

  .footer-brand h3 {
    font-size: 1.5rem;
    margin-block-end: var(--sp-xs);
    font-weight: 800;
  }

  .footer-brand p {
    opacity: 0.85;
    font-size: 0.95rem;
  }

  .copy {
    margin-block-start: var(--sp-m);
    opacity: 0.7;
    letter-spacing: 0.02em;
    font-size: 0.9rem;
  }
</style>
