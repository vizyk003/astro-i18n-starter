---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
const t = useTranslations(Astro.currentLocale as Lang);

const locale = Astro.currentLocale as Lang;

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));
---

<Layout title={t({ ja: "会社概要", en: "About", "zh-cn": "关于", ar: "معلومات عنا" })}>
  <section class="about">
    <h1>
      {
        t({
          ja: "会社概要",
          en: "About Mosaik Digital",
          "zh-cn": "关于 Mosaik Digital",
          ar: "حول Mosaik Digital",
        })
      }
    </h1>

    <div class="content">
      <p class="lead">
        {
          t({
            ja: "Mosaik Digitalは、クリエイティビティとテクノロジーを融合させ、お客様のビジネスに価値をもたらすデジタルエージェンシーです。",
            en: "Mosaik Digital is a creative digital agency that brings together creativity and technology to deliver value to your business.",
            "zh-cn": "Mosaik Digital是一家创意数字机构，融合创意和技术，为您的业务带来价值。",
            ar: "Mosaik Digital هي وكالة رقمية إبداعية تجمع بين الإبداع والتكنولوجيا لتقديم القيمة لعملك.",
          })
        }
      </p>

      <h2>
        {
          t({
            ja: "私たちのミッション",
            en: "Our Mission",
            "zh-cn": "我们的使命",
            ar: "مهمتنا",
          })
        }
      </h2>
      <p>
        {
          t({
            ja: "革新的なデジタルソリューションを通じて、お客様のビジョンを実現し、ビジネスの成長を加速させることです。",
            en: "To realize our clients' visions through innovative digital solutions and accelerate business growth.",
            "zh-cn": "通过创新的数字解决方案实现客户的愿景并加速业务增长。",
            ar: "تحقيق رؤى عملائنا من خلال حلول رقمية مبتكرة وتسريع نمو الأعمال.",
          })
        }
      </p>

      <h2>
        {
          t({
            ja: "私たちの価値観",
            en: "Our Values",
            "zh-cn": "我们的价值观",
            ar: "قيمنا",
          })
        }
      </h2>
      <ul>
        <li>
          <strong>
            {
              t({
                ja: "イノベーション",
                en: "Innovation",
                "zh-cn": "创新",
                ar: "الابتكار",
              })
            }
          </strong>
          {" - "}
          {
            t({
              ja: "常に最新の技術とアプローチを追求",
              en: "Always pursuing the latest technologies and approaches",
              "zh-cn": "始终追求最新的技术和方法",
              ar: "نسعى دائماً لأحدث التقنيات والأساليب",
            })
          }
        </li>
        <li>
          <strong>
            {
              t({
                ja: "品質",
                en: "Quality",
                "zh-cn": "质量",
                ar: "الجودة",
              })
            }
          </strong>
          {" - "}
          {
            t({
              ja: "妥協のない品質へのこだわり",
              en: "Uncompromising commitment to quality",
              "zh-cn": "对质量的不妥协承诺",
              ar: "التزام لا هوادة فيه بالجودة",
            })
          }
        </li>
        <li>
          <strong>
            {
              t({
                ja: "協力",
                en: "Collaboration",
                "zh-cn": "合作",
                ar: "التعاون",
              })
            }
          </strong>
          {" - "}
          {
            t({
              ja: "お客様との緊密なパートナーシップ",
              en: "Close partnership with our clients",
              "zh-cn": "与客户的紧密合作",
              ar: "شراكة وثيقة مع عملائنا",
            })
          }
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about {
    max-width: 900px;
    margin-inline: auto;
    padding-block-start: var(--sp-xl);
    padding-block-end: var(--sp-xl);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-theme);
    margin-block-end: var(--sp-l);
    margin-block-start: 0;
    text-align: center;
  }

  .content {
    line-height: 1.8;
  }

  .lead {
    font-size: 1.2rem;
    margin-block-end: var(--sp-xl);
    margin-block-start: 0;
    text-align: center;
    opacity: 0.9;
    max-width: 800px;
    margin-inline: auto;
  }

  h2 {
    font-size: 1.8rem;
    color: var(--color-theme);
    margin-block-start: var(--sp-xl);
    margin-block-end: var(--sp-m);
  }

  p {
    margin-block-end: var(--sp-m);
    margin-block-start: 0;
    opacity: 0.9;
    font-size: 1.05rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin-block-start: var(--sp-l);
    margin-block-end: 0;
  }

  li {
    margin-block-end: var(--sp-l);
    padding-block: var(--sp-s);
    padding-inline-start: var(--sp-l);
    border-inline-start: 4px solid var(--color-theme);
    background: color-mix(in srgb, var(--color-theme) 3%, transparent);
    border-radius: 0 0.5em 0.5em 0;
    line-height: 1.6;
  }

  li:last-child {
    margin-block-end: 0;
  }

  strong {
    color: var(--color-theme);
    font-size: 1.1rem;
    display: block;
    margin-block-end: 0.3em;
  }
</style>
